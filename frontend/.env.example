# Only needed if the API is on a different origin than the frontend
# (e.g. local Flask dev server). Leave blank for Vercel deploys and
# `vercel dev`, where /api/* is served from the same origin.
VITE_API_BASE_URL=

# Server-side only (used by frontend/api/*.js, never exposed to the browser)
SERPER_API_KEY=your_serper_api_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Used by /api/check-website.js to screenshot + visually judge a lead's
# website (see frontend/api/check-website.js for the request shape).
SCREENSHOT_API_KEY=your_screenshotone_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
